# Database Configuration (Postgres 16 via psycopg 3)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/polypulse
# Set after preparing both shards. Use localhost:5433 for local commands.
SECONDARY_DATABASE_URL=
# Set the same secondary URL with postgres2:5432 for Compose services.
COMPOSE_SECONDARY_DATABASE_URL=
# Connection pool sizing (use DB_POOL_SIZE=2, DB_MAX_OVERFLOW=0, WORKER_CONCURRENCY=1 on Supabase Free)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
# Set to 'require' for remote/Supabase/Render Postgres over WAN; leave unset locally.
DB_SSLMODE=
WORKER_CONCURRENCY=4
# Set to 0 to disable COPY staging; batches at or above this size use COPY.
INGESTION_COPY_THRESHOLD=1000
# Raw ticks older than this move to an exact archive and receive hourly rollups.
PRICE_RAW_RETENTION_DAYS=7
# Phase 7 remains opt-in until runtime parity and recovery tests pass.
ACCOUNTING_PARALLEL_PROCESSES=0
ACCOUNTING_PARALLEL_WALLETS=
# Independent opt-in; works with ACCOUNTING_PARALLEL_PROCESSES=0.
ACCOUNTING_CONDITION_REPLAY_WALLETS=
ACCOUNTING_PARALLEL_TIMEOUT_SECONDS=120
ACCOUNTING_LOCK_TIMEOUT_SECONDS=5
ACCOUNTING_STATEMENT_TIMEOUT_SECONDS=120
ACCOUNTING_ATTEMPT_TIMEOUT_SECONDS=120
WALLET_CYCLE_TIMEOUT_SECONDS=180
ACCOUNTING_CHECKPOINT_KEEP=32
# Minimum applied-order advance between snapshots; 1 preserves existing cadence.
# Increase on measured workloads to reduce full-wallet snapshot work.
ACCOUNTING_CHECKPOINT_INTERVAL=1

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
# Optional explicit replica label (falls back to RENDER_INSTANCE_ID -> hostname + boot id)
APP_INSTANCE_ID=
FLEET_HEARTBEAT_SECONDS=10
# Set to 6 in cloud deployments for graceful LB draining on SIGTERM
SHUTDOWN_DRAIN_SECONDS=0

# CORS & WebSocket Origin Allowlist (e.g. Vercel dashboard)
CORS_ORIGINS=http://localhost:3000
CORS_ORIGIN_REGEX=
WS_ALLOW_EMPTY_ORIGIN=true

# Polymarket API Endpoints
CANONICAL_SOURCE=data_api
DATA_API_BASE_URL=https://data-api.polymarket.com
GAMMA_API_BASE_URL=https://gamma-api.polymarket.com
MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Optional Polygon RPC Endpoint (TODO(verify) - Phase 2)
POLYGON_RPC_URL=

# Serving Layer Security & Price Injection Authentication
POLYPULSE_API_KEY=change-me


